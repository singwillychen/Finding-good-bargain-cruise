# Copy to .env on the NAS and fill in. Never commit .env.

# Vacations To Go login (needed for the 90-Day Ticker)
VTG_EMAIL=
VTG_PASSWORD=

# Telegram: create a bot with @BotFather, then get your chat id
# (send the bot a message, then run: cruise telegram-chat-id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Where the SQLite database and raw page snapshots live
DATA_DIR=/data

# Schedules (Asia/Taipei). Cron fields: minute hour day month day_of_week
SCRAPE_CRON=30 3 * * *
DIGEST_CRON=0 9 * * mon
DIGEST_MAX_ITEMS=5
DIGEST_MIN_SCORE=60

# Which sources to scrape: comma-separated from vtg,cruisedirect,demo
SOURCES=vtg,cruisedirect
